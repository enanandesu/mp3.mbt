   b"\xff\xe3\x38\x64\x00\x0e\x38\x81\x24\x00\xad\x18\x00\x8d\xf8\xa6\x74\x21\x58\x00\x03\xa7\x95\xc6\xdf\xf7\x6d\xad\xa5\xfa\x01\xd5\xda\x3c\x18\x42\x86\x89\x81\xba\x80\x70\xa0\x1b\xa6\x06\x88\x70\xc1\x13\x73\x24\xfe\x76\x3d\xd5\x8d\xc1\x44\x10\x98\xf2\x66\x3c\x1a\xd2\x2d\x01\x08\x13\x28\x20\x55\x09\xc7\xca\x7d\xfe\x9f\x5c\x27\x0c\xd9\x28\xe3\x44\x90\xce\x06\x4c\xf5\xa6\x5d\xf4\x1f\x50\x75\x8e\xce\xdc\xb7\x7d\xae\x39\x0f\xe3\xf9\x0e\x46\x23\x11\x89\x60\x0c\x06\x4c\x99\x32\x64\xc9\xa7\x00\x00\x00\x00\x01\xe1\xe1\xe1\xe1\x80\x00\x02\x3c\x3c\x9f\xfb\xcf\x3c\xe9\xe9\xed\xd4\x7d\x14\xc1\x09\x08\x04\x4c\x06\x98\xdd\xcb\x86\x68\x41\x98\x45\xf0\x79\x22\x6e\x5b\x3b\x6b\xf4\xd1\x75\xe0\x04\x11\x99\x06\x61\x23\x84\x02\xb0\xee\x3d\xed\x52\x52\x52\x00\x00\x07\x8f\xff\xd2\x40\x30\x20\x0d\x66\x8c\xbe\x26\x01\x40\x05\xf8\xca\x82\x80\x0b\xff\xed\xb9\x84\xc8\x4a\x19\x59\x06\xff\xe3\x38\x44\x19\x0b\xec\x55\x32\x0c\xcf\x24\x00\x18\xd9\x42\x60\x01\x9e\x98\x00\x71\x8c\xe0\x8e\x84\x04\x50\x24\x19\x0c\x30\x5a\xb0\xd0\xb4\x3a\xcc\x19\xc0\x90\x78\x06\x0c\x3a\x4f\x68\xd6\xdc\x00\x89\x81\xb8\x68\x09\x19\xa3\x27\x76\x05\x80\x36\x55\x7f\x89\x99\xff\xe7\x06\xd0\x2c\x9c\x88\xfc\x19\x03\x00\xcd\x7f\xbd\x7f\xff\x32\x84\x27\xff\xfd\xbb\xbf\xff\xbd\x72\x38\x11\xc3\x86\xf1\xd6\xea\xff\xff\xa8\xd2\xeb\x0a\x00\x7a\x36\x73\x77\x88\x00\x57\xfe\xb3\xb2\x61\x0a\x0d\x66\x0c\x6a\xf6\x69\xb6\x08\xe8\x16\x16\x01\x53\x0a\xe5\x4d\x33\xe5\x10\x83\x04\x90\x35\x79\xcc\x41\x8c\xec\xd8\x38\xd3\x83\x87\x04\x0f\x01\x05\x04\x1c\xc1\x3e\x8d\xf1\xc0\x2c\xe2\x4c\xa0\x64\x9a\xbf\x2a\x13\xe4\x50\xc0\xcc\xc0\xc8\xea\xbf\xff\x9c\x48\xe8\x32\x6c\x07\xff\x9a\x78\xd5\x2e\xff\xff\xfa\xb2\xd7\x89\x4b\x82\xe0\x01\x20\x70\x20\x02\x13\x01\x10\x04\xf0\x80\x17\x41\x20\x32\x18\xff\xe3\x38\x44\x19\x09\xc8\x3f\x14\x00\xef\x80\x00\x15\x48\xb2\x30\x01\xdf\x00\x01\x32\xe0\x7b\x18\x3b\xe2\xbd\x18\xd6\x27\x8d\x1a\x9b\x87\x34\x9c\xda\xe8\xe6\x99\xc2\xe2\xa0\x98\x12\x20\xc2\x18\x2c\x80\xb8\x98\x06\xc0\x12\x18\x05\x80\x00\x98\x09\x60\x21\x09\x00\x1