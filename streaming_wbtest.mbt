// END FIXED STREAM INPUTS

///|
fn stream_collect(
  data : Bytes,
  chunks : Array[Int],
  limits? : Limits = Limits::default(),
) -> (Array[PcmFrame], Int) raise {
  let decoder = Decoder::new(limits~)
  let frames : Array[PcmFrame] = []
  let mut offset = 0
  let mut step = 0
  let mut peak = 0
  while offset < data.length() {
    assert_true(step <= data.length() + 8, msg="stream did not consume input")
    let requested = chunks[step % chunks.length()]
    let count = if requested < data.length() - offset {
      requested
    } else {
      data.length() - offset
    }
    let part = data[offset:offset + count].to_bytes()
    let accepted = decoder.push(part)
    assert_true(accepted >= 0 && accepted <= part.length())
    offset += accepted
    let buffered = decoder.buffered_bytes()
    assert_true(buffered >= 0 && buffered <= limits.max_buffer_bytes)
    if buffered > peak {
      peak = buffered
    }
    let mut produced = 0
    while true {
      match decoder.next_frame() {
        Frame(frame) => {
          frames.push(frame)
          produced += 1
        }
        NeedMoreInput => break
        EndOfInput => fail("EndOfInput before finish_input")
      }
    }
    assert_true(accepted > 0 || produced > 0, msg="full-buffer deadlock")
    step += 1
  }
  decoder.finish_input()
  decoder.finish_input()
  let mut final_steps = 0
  while true {
    assert_true(final_steps <= data.length() + 8, msg="EOF did not terminate")
    match decoder.next_frame() {
      Frame(frame) => frames.push(frame)
      EndOfInput => break
      NeedMoreInput => fail("NeedMoreInput after complete EOF")
    }
    final_steps += 1
  }
  assert_true(decoder.next_frame() is EndOfInput)
  assert_true(decoder.buffered_bytes() <= limits.max_buffer_bytes)
  (frames, peak)
}

///|
fn stream_audio(data : Bytes, chunks : Array[Int]) -> Audio raise {
  let (frames, _) = stream_collect(data, chunks)
  if frames.is_empty() {
    raise NoAudio
  }
  let samples : Array[Float] = []
  for frame in frames {
    assert_eq(frame.sample_rate, frames[0].sample_rate)
    assert_eq(frame.channels, frames[0].channels)
    for sample in frame.samples {
      samples.push(sample)
    }
  }
  { sample_rate: frames[0].sample_rate, channels: frames[0].channels, samples, }
}

///|
fn stream_assert_same(data : Bytes, chunks : Array[Int]) -> Unit raise {
  match (try? decode_all(data), try? stream_audio(data, chunks)) {
    (Ok(whole), Ok(chunked)) => {
      assert_eq(chunked.sample_rate, whole.sample_rate)
      assert_eq(chunked.channels, whole.channels)
      assert_eq(chunked.samples, whole.samples)
    }
    (Err(whole), Err(chunked)) =>
      assert_eq(chunked.to_string(), whole.to_string())
    (Ok(_), Err(error)) => fail("chunked decode alone failed: \{error}")
    (Err(error), Ok(_)) => fail("whole-buffer decode alone failed: \{error}")
  }
}

///|
fn stream_next_error(decoder : Decoder) -> Mp3Error? {
  try {
    let _ = decoder.next_frame()
    None
  } catch {
    error => Some(error)
  }
}

///|
fn stream_push_error(
  decoder : Decoder,
  data : Bytes,
  offset? : Int = 0,
) -> Mp3Error? {
  try {
    let _ = decoder.push(data, offset~)
    None
  } catch {
    error => Some(error)
  }
}

///|
fn stream_finish_error(decoder : Decoder) -> Mp3Error? {
  try {
    decoder.finish_input()
    None
  } catch {
    error => Some(error)
  }
}

///|
fn stream_new_error(limits : Limits) -> Mp3Error? {
  try {
    let _ = Decoder::new(limits~)
    None
  } catch {
    error => Some(error)
  }
}

///|
fn stream_tag(payload : Int, footer? : Bool = true) -> Bytes {
  let flags = if footer { 16 } else { 0 }
  let header = [
    b'I',
    b'D',
    b'3',
    4,
    0,
    flags.to_byte(),
    ((payload >> 21) & 127).to_byte(),
    ((payload >> 14) & 127).to_byte(),
    ((payload >> 7) & 127).to_byte(),
    (payload & 127).to_byte(),
  ]
  Bytes::makei(10 + payload + (if footer { 10 } else { 0 }), fn(i) {
    if i < 10 {
      header[i]
    } else if i >= 10 + payload {
      let j = i - 10 - payload
      match j {
        0 => b'3'
        1 => b'D'
        2 => b'I'
        _ => header[j]
      }
    } else {
      (i * 59 % 251).to_byte()
    }
  })
}

///|
fn stream_free(version : Int, base : Int, pads : Array[Int]) -> Bytes {
  let bytes : Array[Byte] = []
  for pad in pads {
    bytes.push(255)
    bytes.push([251, 243, 227][version].to_byte())
    bytes.push((pad << 1).to_byte())
    bytes.push(192)
    for _i = 4; _i < base + pad; _i = _i + 1 {
      bytes.push(0)
    }
  }
  Bytes::from_array(bytes)
}

///|
test "free format discovery and EOF two-frame fallback survive chunking" {
  for version in [0, 1, 2] {
    let data = stream_free(version, 79, [1, 0, 1, 0])
    for chunks in [[1], [4, 79, 3, 157], [8192]] {
      let (frames, _) = stream_collect(data, chunks)
      assert_eq(frames.length(), 4)
      assert_eq(frames[0].source_offset, 0L)
      assert_eq(frames[1].source_offset, 80L)
      assert_eq(frames[2].source_offset, 159L)
      assert_eq(frames[3].source_offset, 239L)
      for frame in frames {
        assert_eq(frame.channels, 1)
        assert_eq(frame.samples.length(), if version == 0 { 1152 } else { 576 })
      }
      stream_assert_same(data, chunks)
    }
    let small_tail = Bytes::makei(128, fn(i) {
      match i {
        0 => b'T'
        1 => b'A'
        2 => b'G'
        _ => 0
      }
    })
    let small_pair = entry_join(stream_free(version, 79, [1, 0]), small_tail)
    let (small_frames, _) = stream_collect(small_pair, [1, 13, 157])
    assert_eq(small_frames.length(), 2)
    assert_eq(small_frames[1].source_offset, 80L)
    stream_assert_same(small_pair, [1, 13, 157])
  }
  let maximum_pair = stream_free(0, 2304, [1, 1])
  let limits = { ..Limits::default(), max_buffer_bytes: 4969, }
  let (frames, peak) = stream_collect(maximum_pair, [2304, 1, 2305], limits~)
  assert_eq(frames.length(), 2)
  assert_eq(frames[1].source_offset, 2305L)
  assert_true(peak <= 4969)
  // The two-frame EOF exception must remain usable with legal trailing tags,
  // including maximum frames and the complete enhanced trailing tag.
  for enhanced in [false, true] {
    let extra = if enhanced { 227 } else { 0 }
    let tail = Bytes::makei(128 + extra, fn(i) {
      if i == extra {
        b'T'
      } else if i == extra + 1 {
        b'A'
      } else if i == extra + 2 {
        b'G'
      } else if enhanced && i < 4 {
        b"TAG+"[i]
      } else {
        0
      }
    })
    let tagged = entry_join(maximum_pair, tail)
    let (frames, peak) = stream_collect(tagged, [2304, 1, 2305, 355], limits~)
    assert_eq(frames.length(), 2)
    assert_eq(frames[1].source_offset, 2305L)
    assert_true(peak <= 4969)
    let corrupted_tail = Bytes::makei(tagged.length(), fn(i) {
      if i == maximum_pair.length() + extra + 2 {
        b'X'
      } else {
        tagged[i]
      }
    })
    assert_true((try? stream_audio(corrupted_tail, [2304, 1, 355])) is Err(_))
    stream_assert_same(corrupted_tail, [2304, 1, 355])
  }
  for data in [stream_free(0, 2304, [1]), stream_free(0, 79, [0])] {
    assert_true((try? stream_audio(data, [1, 31])) is Err(_))
    stream_assert_same(data, [1, 31])
  }
}

///|
test "channel sample-rate and version changes fail while coded bitrate may vary" {
  let first = entry_frame(1)
  let mpeg2 = Bytes::makei(208, fn(i) {
    match i {
      0 => 255
      1 => 243
      2 => 128
      3 => 192
      _ => 0
    }
  })
  for changed in [entry_frame(2), entry_frame(1, rate=2), mpeg2] {
    let decoder = Decoder::new()
    let _ = decoder.push(entry_join(first, changed))
    decoder.finish_input()
    assert_true(decoder.next_frame() is Frame(_))
    assert_eq(stream_next_error(decoder), Some(FormatChange(417L)))
    assert_eq(stream_next_error(decoder), Some(FailedDecoder))
    decoder.reset()
    assert_eq(decoder.buffered_bytes(), 0)
  }
  let smaller_bitrate = Bytes::makei(313, fn(i) {
    match i {
      0 => 255
      1 => 251
      2 => 112
      3 => 192
      _ => 0
    }
  })
  let data = entry_join(first, smaller_bitrate)
  let (frames, _) = stream_collect(data, [1, 417, 3])
  assert_eq(frames.length(), 2)
  assert_eq(frames[1].source_offset, 417L)
  stream_assert_same(data, [1, 417, 3])
}

///|
test "three-version nonzero PCM and offsets are invariant to chunk boundaries" {
  for data in stream_inputs {
    let expected = decode_all(data)
    assert_true(expected.samples.iter().any(fn(value) { value != 0.0 }))
    for chunks in [[1], [2, 3, 5, 7, 11], [4096], [4, 17, 416, 1, 8192]] {
      let (frames, _) = stream_collect(data, chunks)
      assert_eq(frames.length(), 4)
      let samples : Array[Float] = []
      let mut source = 0
      for frame in frames {
        let header = @header.parse(data, offset=source).unwrap()
        assert_eq(frame.source_offset, source.to_int64())
        assert_eq(frame.sample_rate, expected.sample_rate)
        assert_eq(frame.channels, expected.channels)
        assert_eq(
          frame.samples.length(),
          header.samples_per_frame() * header.channels(),
        )
        for value in frame.samples {
          samples.push(value)
        }
        source += header.frame_bytes().unwrap().unwrap()
      }
      assert_eq(source, data.length())
      assert_eq(samples, expected.samples)
    }
  }
}

///|
test "bounded push returns exact accepted bytes and applies backpressure" {
  let limits = { ..Limits::default(), max_buffer_bytes: 4969, }
  let decoder = Decoder::new(limits~)
  let frame = entry_frame(1)
  let data = Bytes::makei(frame.length() * 30, fn(i) {
    frame[i % frame.length()]
  })
  assert_eq(decoder.push(data), 4969)
  assert_eq(decoder.buffered_bytes(), 4969)
  assert_eq(decoder.push(data, offset=4969), 0)
  assert_eq(decoder.buffered_bytes(), 4969)
  match decoder.next_frame() {
    Frame(output) => assert_eq(output.samples.length(), 1152)
    other => fail("expected one frame under backpressure: \{other}")
  }
  assert_eq(decoder.buffered_bytes(), 4969 - 417)
  assert_eq(decoder.push(data, offset=4969), 417)
  assert_eq(decoder.buffered_bytes(), 4969)
  decoder.reset()
  assert_eq(decoder.buffered_bytes(), 0)
  assert_eq(decoder.push(b""), 0)
  assert_true(decoder.next_frame() is NeedMoreInput)
  // A synthetic transport origin validates 64-bit accounting without creating
  // multi-gigabyte input or weakening the fixed-capacity memory contract.
  let large_offset = 2147483648L + 123L
  decoder.source_offset = large_offset
  let _ = decoder.push(entry_join(frame, frame))
  for index = 0; index < 2; index = index + 1 {
    match decoder.next_frame() {
      Frame(output) =>
        assert_eq(
          output.source_offset,
          large_offset + index.to_int64() * frame.length().to_int64(),
        )
      other => fail("large source offset lost a frame: \{other}")
    }
  }
  assert_eq(
    decoder.source_offset,
    large_offset + 2L * frame.length().to_int64(),
  )
}

///|
test "limits and push offset misuse are structured and do not poison decoder" {
  let defaults = Limits::default()
  assert_eq(defaults.max_buffer_bytes, 8192)
  for
    limits in [
      { ..defaults, max_buffer_bytes: 4968, },
      { ..defaults, max_buffer_bytes: 1048577, },
      { ..defaults, max_free_format_bytes: 3, },
      { ..defaults, max_free_format_bytes: 2305, },
      { ..defaults, max_tag_bytes: -1, },
      { ..defaults, max_initial_scan: -1, },
      { ..defaults, max_output_samples: -1, },
    ] {
    assert_eq(stream_new_error(limits), Some(InvalidLimits))
  }
  assert_eq(
    stream_new_error({
      ..defaults,
      max_buffer_bytes: 2885,
      max_free_format_bytes: 4,
    }),
    None,
  )
  let decoder = Decoder::new()
  for offset in [-1, 4, 2147483647] {
    assert_eq(
      stream_push_error(decoder, b"abc", offset~),
      Some(InvalidInputOffset(offset)),
    )
    assert_eq(decoder.buffered_bytes(), 0)
  }
  assert_eq(decoder.push(b"abc", offset=3), 0)
  assert_eq(decoder.push(entry_frame(1)), 417)
  assert_true(decoder.next_frame() is Frame(_))
}

///|
test "EOF is idempotent and a reset permits reuse after EOF or fatal errors" {
  let empty = Decoder::new()
  assert_true(empty.next_frame() is NeedMoreInput)
  empty.finish_input()
  empty.finish_input()
  assert_true(empty.next_frame() is EndOfInput)
  assert_true(empty.next_frame() is EndOfInput)
  assert_eq(stream_push_error(empty, b"x"), Some(InputFinished))
  assert_true(empty.next_frame() is EndOfInput)
  empty.reset()
  assert_eq(empty.buffered_bytes(), 0)
  assert_true(empty.next_frame() is NeedMoreInput)
  let _ = empty.push(entry_frame(1, history=1))
  assert_eq(
    stream_next_error(empty),
    Some(DecodeFailure(0L, @layer3.InsufficientHistory(1, 0))),
  )
  assert_eq(stream_next_error(empty), Some(FailedDecoder))
  assert_eq(stream_push_error(empty, b""), Some(FailedDecoder))
  assert_eq(stream_finish_error(empty), Some(FailedDecoder))
  empty.reset()
  let data = stream_inputs[0]
  assert_eq(empty.push(data), data.length())
  empty.finish_input()
  let expected = decode_all(data)
  let samples : Array[Float] = []
  while true {
    match empty.next_frame() {
      Frame(frame) =>
        for value in frame.samples {
          samples.push(value)
        }
      EndOfInput => break
      NeedMoreInput => fail("reset stream stalled at EOF")
    }
  }
  assert_eq(samples, expected.samples)
}

///|
test "returned streaming PCM survives later frames EOF and reset" {
  let decoder = Decoder::new()
  let data = stream_inputs[0]
  let _ = decoder.push(data)
  let first = match decoder.next_frame() {
    Frame(frame) => frame
    _ => fail("first frame unavailable")
  }
  assert_true(first.samples.iter().any(fn(value) { value != 0.0 }))
  let retained = first.samples.copy()
  // Caller writes must not alias reservoir, DSP history, or another frame.
  first.samples[0] = 12345.0
  retained[0] = 12345.0
  let fresh = Decoder::new()
  let _ = fresh.push(data)
  assert_true(fresh.next_frame() is Frame(_))
  fresh.finish_input()
  decoder.finish_input()
  for _i = 0; _i < 3; _i = _i + 1 {
    match (decoder.next_frame(), fresh.next_frame()) {
      (Frame(actual), Frame(expected)) =>
        assert_eq(actual.samples, expected.samples)
      _ => fail("caller-mutated PCM changed subsequent frame availability")
    }
    assert_eq(first.samples, retained)
  }
  assert_true(decoder.next_frame() is EndOfInput)
  decoder.reset()
  let _ = decoder.push(data)
  assert_true(decoder.next_frame() is Frame(_))
  assert_eq(first.samples, retained)
}

///|
test "large ID3 footer and enhanced tail span bounded buffers and tiny chunks" {
  let prefix = stream_tag(20000)
  let suffix = Bytes::makei(355, fn(i) {
    match i {
      0 | 227 => b'T'
      1 | 228 => b'A'
      2 | 229 => b'G'
      3 => b'+'
      _ => 0
    }
  })
  let original = stream_inputs[0]
  let data = entry_join(entry_join(prefix, original), suffix)
  let expected = decode_all(original)
  let limits = {
    ..Limits::default(),
    max_buffer_bytes: 4969,
    max_tag_bytes: 20020,
  }
  for chunks in [[1], [9, 10, 4969, 3, 127, 227], [65536]] {
    let (frames, peak) = stream_collect(data, chunks, limits~)
    assert_eq(frames.length(), 4)
    assert_eq(frames[0].source_offset, prefix.length().to_int64())
    assert_true(peak <= limits.max_buffer_bytes)
    let samples : Array[Float] = []
    for frame in frames {
      for value in frame.samples {
        samples.push(value)
      }
    }
    assert_eq(samples, expected.samples)
  }
  let corrupt_footer = Bytes::makei(data.length(), fn(i) {
    if i == prefix.length() - 1 {
      (data[i].to_int() ^ 1).to_byte()
    } else {
      data[i]
    }
  })
  let result = try? stream_collect(corrupt_footer, [1, 4096, 7], limits~)
  assert_true(result is Err(InvalidTag))
  let smaller = { ..limits, max_tag_bytes: 20019, }
  assert_true(
    (try? stream_collect(data, [7], limits=smaller)) is Err(InvalidTag),
  )
}

///|
test "long incremental stream has bounded retained input and no cumulative output cap" {
  let limits = {
    ..Limits::default(),
    max_buffer_bytes: 4969,
    max_output_samples: 1,
  }
  let decoder = Decoder::new(limits~)
  let frame = entry_frame(1)
  let mut frames = 0
  assert_eq(decoder.ring.length(), limits.max_buffer_bytes)
  for _i = 0; _i < 1024; _i = _i + 1 {
    assert_eq(decoder.push(frame), frame.length())
    assert_true(decoder.buffered_bytes() <= limits.max_buffer_bytes)
    while true {
      match decoder.next_frame() {
        Frame(output) => {
          assert_eq(output.samples.length(), 1152)
          frames += 1
        }
        NeedMoreInput => break
        EndOfInput => fail("early EOF during long input")
      }
    }
    assert_true(decoder.buffered_bytes() <= limits.max_buffer_bytes)
    assert_eq(decoder.ring.length(), limits.max_buffer_bytes)
  }
  decoder.finish_input()
  while true {
    match decoder.next_frame() {
      Frame(_) => frames += 1
      EndOfInput => break
      NeedMoreInput => fail("long input not finished")
    }
  }
  assert_eq(frames, 1024)
  assert_eq(decoder.ring.length(), limits.max_buffer_bytes)
  assert_true((try? decode_all(frame, limits~)) is Err(OutputLimit))
}

///|
test "deterministic truncations byte flips and noise agree across chunkings" {
  let data = stream_inputs[0]
  // Every byte prefix of one complete nonzero stereo frame, followed by
  // selected boundaries across all four frames of the same real stream.
  let first_length = @header.parse(data)
    .unwrap()
    .frame_bytes()
    .unwrap()
    .unwrap()
  for cut = 0; cut <= first_length; cut = cut + 1 {
    stream_assert_same(data[:cut].to_bytes(), [1, 17, 113])
  }
  for
    cut in [
      0, 1, 2, 3, 4, 20, 35, 36, 100, 416, 417, 575, 576, 577, 1151, 1152, 2303,
    ] {
    stream_assert_same(data[:cut].to_bytes(), [1, 3, 19, 128])
  }
  let mut seed = 0x31504159U
  for iteration = 0; iteration < 64; iteration = iteration + 1 {
    seed = seed * 1664525U + 1013904223U
    let byte_index = (seed % data.length().reinterpret_as_uint()).reinterpret_as_int()
    let bit = 1 << (iteration % 8)
    let mutated = Bytes::makei(data.length(), fn(i) {
      if i == byte_index {
        (data[i].to_int() ^ bit).to_byte()
      } else {
        data[i]
      }
    })
    stream_assert_same(mutated, [1, 7, 31, 257])
  }
  for length in [1, 3, 4, 31, 127, 355, 1024] {
    let noise = Bytes::makei(length, fn(i) {
      ((i * 73 + length * 19) & 255).to_byte()
    })
    stream_assert_same(noise, [1, 2, 11])
  }
  // Valid sync words inside otherwise invalid data must never cause unbounded
  // scanning, hidden resynchronization after a frame, or a backend trap.
  stream_assert_same(entry_join(b"\x11\x22\xff\xfb\x90\xc0", data), [1, 13, 41])
}

///|
test "incomplete frames before EOF remain retryable without advancing DSP" {
  let data = stream_inputs[0]
  let length = @header.parse(data).unwrap().frame_bytes().unwrap().unwrap()
  let decoder = Decoder::new()
  let first = data[:length].to_bytes()
  assert_eq(decoder.push(first[:length - 1].to_bytes()), length - 1)
  for _i = 0; _i < 3; _i = _i + 1 {
    assert_true(decoder.next_frame() is NeedMoreInput)
    assert_eq(decoder.buffered_bytes(), length - 1)
  }
  assert_eq(decoder.push(first, offset=length - 1), 1)
  let fresh = Decoder::new()
  let _ = fresh.push(first)
  match (decoder.next_frame(), fresh.next_frame()) {
    (Frame(actual), Frame(expected)) => {
      assert_eq(actual.samples, expected.samples)
      assert_eq(actual.source_offset, 0L)
    }
    _ => fail("retrying the last frame byte changed decode availability")
  }
  assert_true(decoder.next_frame() is NeedMoreInput)
  decoder.finish_input()
  assert_true(decoder.next_frame() is EndOfInput)
}

///|
test "256 fixed-seed pseudorandom byte inputs terminate consistently" {
  // LCG seed and case count are fixed regression inputs, never system entropy.
  // Include empty and maximum-size cases explicitly; other lengths span 0..4096.
  let mut seed = 0x98badcfeU
  for case = 0; case < 256; case = case + 1 {
    seed = seed * 1664525U + 1013904223U
    let length = if case == 0 {
      0
    } else if case == 1 {
      4096
    } else {
      (seed % 4097U).reinterpret_as_int()
    }
    let bytes = Bytes::makei(length, fn(_) {
      seed = seed * 1664525U + 1013904223U
      (seed >> 24).reinterpret_as_int().to_byte()
    })
    stream_assert_same(bytes, [1, 17, 113])
  }
}

///|
test "TAG signatures inside free-format frame payload never trim audio" {
  // Zero-spectrum side info makes these arbitrary ancillary payload bytes
  // legal. The TAG positions are not frame boundaries. EOF before any call
  // to next_frame must discover the same spacing as one-byte streaming.
  for item in [(79, 3, false), (200, 2, false), (200, 3, true), (250, 2, true)] {
    let (base, count, enhanced) = item
    let original = stream_free(0, base, Array::make(count, 0))
    let tag = original.length() - 128
    let extended = original.length() - 355
    let data = Bytes::makei(original.length(), fn(i) {
      if i >= tag && i < tag + 3 {
        b"TAG"[i - tag]
      } else if enhanced && i >= extended && i < extended + 4 {
        b"TAG+"[i - extended]
      } else {
        original[i]
      }
    })
    if count == 3 {
      let (early_discovery, _) = stream_collect(data, [1])
      assert_eq(early_discovery.length(), count)
    }
    let whole = decode_all(data)
    assert_eq(whole.samples.length(), count * 1152)
    assert_eq(whole.samples, Array::make(count * 1152, 0.0))
    stream_assert_same(data, [1])
    stream_assert_same(data, [8192])
  }
}
