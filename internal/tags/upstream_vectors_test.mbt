///|
test "valid trailing tags match pinned C oracle" {
  let cases = [
    (0, false, false, 0),
    (0, false, true, 128),
    (0, true, true, 355),
    (0, true, false, 0),
    (1, false, false, 0),
    (1, false, true, 128),
    (1, true, true, 355),
    (1, true, false, 0),
    (127, false, false, 0),
    (127, false, true, 128),
    (127, true, true, 355),
    (127, true, false, 0),
    (128, false, false, 0),
    (128, false, true, 128),
    (128, true, true, 355),
    (128, true, false, 0),
    (227, false, false, 0),
    (227, false, true, 128),
    (227, true, true, 355),
    (227, true, false, 0),
    (1024, false, false, 0),
    (1024, false, true, 128),
    (1024, true, true, 355),
    (1024, true, false, 0),
  ]
  for entry in cases {
    let (audio, enhanced, standard, expected) = entry
    let bytes = tail(audio, enhanced, standard)
    let info = trim_id3v1(bytes[:])
    assert_eq(info.tag_bytes, expected)
    assert_eq(info.audio_end, bytes.length() - expected)
    assert_eq(info.enhanced, enhanced && standard)
  }
}
