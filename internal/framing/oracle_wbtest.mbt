  [2, 2, 2, 1, 5, 1024, 0, 1025, 1024],
  [2, 2, 2, 1, 5, 2302, 0, 2303, 2302],
  [2, 2, 2, 1, 6, 64, 0, 64, 64],
  [2, 2, 2, 1, 6, 129, 0, 129, 129],
  [2, 2, 2, 1, 6, 511, 0, 511, 511],
  [2, 2, 2, 1, 6, 1024, 0, 1024, 1024],
  [2, 2, 2, 1, 6, 2302, 0, 2302, 2302],
  [2, 2, 2, 1, 7, 64, 0, 65, 64],
  [2, 2, 2, 1, 7, 129, 0, 130, 129],
  [2, 2, 2, 1, 7, 511, 0, 512, 511],
  [2, 2, 2, 1, 7, 1024, 0, 1025, 1024],
  [2, 2, 2, 1, 7, 2302, 0, 2303, 2302],
]

///|
test "1440 original C free-format discovery vectors" {
  assert_eq(framing_c_vectors.length(), 1440)
  for row in framing_c_vectors {
    let data = framing_stream(row[0], row[1], row[2], row[3], row[4], row[5])
    assert_eq(row[6], 0)
    assert_eq(
      probe(data, framing_header(data), false, None),
      Frame(row[7], Some(row[8])),
    )
  }
}
