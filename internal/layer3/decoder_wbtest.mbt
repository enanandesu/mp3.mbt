// END GENERATED DECODER STATE INPUTS

///|
fn decoder_patch(
  frame : Bytes,
  position : Int,
  width : Int,
  value : Int,
) -> Bytes {
  Bytes::makei(frame.length(), fn(i) {
    let mut byte = frame[i].to_int()
    for bit = 0; bit < width; bit = bit + 1 {
      let pos = position + bit
      if pos / 8 == i {
        let mask = 1 << (7 - pos % 8)
        byte = (byte & (255 ^ mask)) |
          (((value >> (width - 1 - bit)) & 1) << (7 - pos % 8))
      }
    }
    byte.to_byte()
  })
}

///|
fn decoder_nonzero(samples : Array[Float]) -> Bool {
  samples.iter().any(fn(sample) { sample != 0.0 })
}

///|
fn decoder_assert_reset(decoder : FrameDecoder) -> Unit raise {
  assert_eq(decoder.reservoir.history, b"")
  assert_eq(decoder.previous, None)
  assert_eq(decoder.failed, false)
  assert_true(!decoder_nonzero(decoder.qmf))
  for channel in decoder.overlap {
    assert_true(!decoder_nonzero(channel))
  }
}

///|
test "fatal second granule dirties DSP state then reset equals new decoder" {
  let decoder = FrameDecoder::new()
  for i = 0; i < 2; i = i + 1 {
    let pcm = decoder.decode_frame(decoder_stereo_frames[i])
    assert_true(decoder_nonzero(pcm))
  }
  assert_true(decoder_nonzero(decoder.overlap[0]))
  assert_true(decoder_nonzero(decoder.overlap[1]))
  assert_true(decoder_nonzero(decoder.qmf))
  assert_true(decoder.reservoir.history.length() > 0)
  let before_qmf = decoder.qmf.copy()
  let before_overlap = decoder.overlap[0].copy()
  let before_reservoir = decoder.reservoir.history
  let original = decoder_stereo_frames[2]
  let header = @header.parse(original).unwrap()
  let start = (4 + header.crc_bytes()) * 8
  // Preserve both channels in granule zero. In granule one's left channel,
  // zero part_23_length plus scalefac_compress=15 forces a read of 4 bits from
  // a zero-bit budget. Disable scfsi so no reuse can avoid that read.
  let bad = decoder_patch(
    decoder_patch(
      decoder_patch(original, start + 12, 4, 0),
      start + 20 + 2 * 59,
      12,
      0,
    ),
    start + 20 + 2 * 59 + 29,
    4,
    15,
  )
  let side = read_side_info(bad, @header.parse(bad).unwrap())
  let consumed = side.granules[0].part_23_length +
    side.granules[1].part_23_length
  assert_eq(
    try? decoder.decode_frame(bad),
    Err(BitBudget(consumed, 4, consumed)),
  )
  // These inequalities prove that granule zero really ran hybrid/synthesis
  // before the error, so reset must clear state mutated by a failed frame.
  assert_true(decoder.qmf != before_qmf)
  assert_true(decoder.overlap[0] != before_overlap)
  assert_eq(decoder.reservoir.history, before_reservoir)
  assert_eq(decoder.failed, true)
  assert_eq(
    try? decoder.decode_frame(original),
    Err(InvalidFrame("decoder is failed; reset is required")),
  )
  decoder.reset()
  decoder_assert_reset(decoder)
  let fresh = FrameDecoder::new()
  for frame in decoder_stereo_frames {
    assert_eq(decoder.decode_frame(frame), fresh.decode_frame(frame))
  }
  assert_eq(decoder.reservoir.history, fresh.reservoir.history)
  assert_eq(decoder.overlap, fresh.overlap)
  assert_eq(decoder.qmf, fresh.qmf)
}

///|
test "returned PCM arrays remain owned after later decode and reset" {
  for frames in [decoder_stereo_frames, decoder_mono_frames] {
    let decoder = FrameDecoder::new()
    let pcm = decoder.decode_frame(frames[0])
    assert_true(decoder_nonzero(pcm))
    let retained = pcm.copy()
    for i = 1; i < frames.length(); i = i + 1 {
      let _ = decoder.decode_frame(frames[i])
      assert_eq(pcm, retained)
    }
    decoder.reset()
    assert_eq(pcm, retained)
    let _ = decoder.decode_frame(frames[0])
    assert_eq(pcm, retained)
  }
}

///|
test "format changes are fatal until reset" {
  let first = decoder_stereo_frames[0]
  for
    changed in [decoder_patch(first, 20, 2, 0), decoder_patch(first, 24, 2, 3)] {
    let decoder = FrameDecoder::new()
    let _ = decoder.decode_frame(first)
    assert_eq(
      try? decoder.decode_frame(changed),
      Err(InvalidFrame("stream version, sample rate or channel count changed")),
    )
    assert_eq(
      try? decoder.decode_frame(first),
      Err(InvalidFrame("decoder is failed; reset is required")),
    )
    decoder.reset()
    decoder_assert_reset(decoder)
    assert_eq(
      decoder.decode_frame(decoder_mono_frames[0]),
      FrameDecoder::new().decode_frame(decoder_mono_frames[0]),
    )
  }
}

///|
test "version-length mismatch and unbounded free format fail before DSP state changes" {
  let first = decoder_stereo_frames[0]
  let decoder = FrameDecoder::new()
  assert_eq(
    try? decoder.decode_frame(decoder_patch(first, 11, 2, 2)),
    Err(InvalidFrame("frame length differs from header")),
  )
  assert_eq(decoder.failed, true)
  assert_true(!decoder_nonzero(decoder.qmf))
  decoder.reset()
  assert_eq(
    try? decoder.decode_frame(decoder_patch(first, 16, 4, 0)),
    Err(InvalidFrame("free-format requires bounded frame discovery")),
  )
  assert_eq(decoder.failed, true)
  assert_true(!decoder_nonzero(decoder.qmf))
  decoder.reset()
  decoder_assert_reset(decoder)
  assert_eq(
    decoder.decode_frame(first),
    FrameDecoder::new().decode_frame(first),
  )
}

///|
test "real dependent frame without reservoir history fails and poisons decoder" {
  let dependent = decoder_stereo_frames[2]
  let side = read_side_info(dependent, @header.parse(dependent).unwrap())
  assert_true(side.main_data_begin > 0)
  let decoder = FrameDecoder::new()
  assert_eq(
    try? decoder.decode_frame(dependent),
    Err(InsufficientHistory(side.main_data_begin, 0)),
  )
  assert_eq(decoder.reservoir.history, b"")
  assert_true(!decoder_nonzero(decoder.qmf))
  assert_eq(
    try? decoder.decode_frame(decoder_stereo_frames[0]),
    Err(InvalidFrame("decoder is failed; reset is required")),
  )
  decoder.reset()
  decoder_assert_reset(decoder)
  for i = 0; i < 3; i = i + 1 {
    assert_true(decoder_nonzero(decoder.decode_frame(decoder_stereo_frames[i])))
  }
}
