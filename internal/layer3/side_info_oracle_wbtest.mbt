// Source: tests/corpus/upstream/l3-si.bit; SHA-256: 4f3382de1d9265013d42249ff108023d4a90ecf3c0136489d199243a90a5d0f9

///|
test "C continuous side-info and reservoir: l3-si" {
  let reservoir = Reservoir::new()
  {
    let frame = b"\xff\xfb\x50\xc0\x00\x00\x0b\xa8\x2a\xc8\x0b\xde\xe4\x81\x75\x05\x59\x01\x7b\xdc\x90\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x01\xbf\x95\x00\xff\x2a\xfc\xa8\x0f\xf2\xaf\xca\x80\xff\x2a\xfc\xa8\x0f\xf2\xaf\xca\x80\xff\x2a\xfc\xa8\x0f\xf2\xaf\xca\x80\xff\x2a\xfc\xa8\x0f\xf2\xaf\xca\x80\xff\x2a\xfc\xa8\x0f\xf2\xaf\xca\x80\xff\x2a\xfc\xa8\x0f\xf2\xaf\xca\x80\xff\x2a\xfc\xa8\x0f\xf2\xaf\xca\x80\xff\x2a\xfc\xa8\x0f\xf2\xaf\xca\x80\xff\x2a\xfc\xa8\x0f\xf2\xaf\xca\x80\xff\x2a\xfc\xa8\x0f\xf2\xaf\xca\x80\x6f\xe5\x40"
    let header = @header.parse(frame).unwrap()
    let side = read_side_info(frame, header)
    assert_eq(side.main_data_begin, 0)
    assert_eq(header.main_data_offset() * 8, 168)
    assert_eq(side.granules.length(), 2)
    assert_eq(side_flatten(side.granules[0]), [
      746, 21, 0, 100, 0, 0, 22, 0, 0, 0, 0, 0, 23, 23, 23, 2, 2, 255, 0, 0, 0, 4,
      4, 4, 4, 4, 4, 6, 6, 8, 8, 10, 12, 16, 20, 24, 28, 34, 42, 50, 54, 76, 158,
      0,
    ])
    assert_eq(side_flatten(side.granules[1]), [
      746, 21, 0, 100, 0, 0, 22, 0, 0, 0, 0, 0, 23, 23, 23, 2, 2, 255, 0, 0, 0, 4,
      4, 4, 4, 4, 4, 6, 6, 8, 8, 10, 12, 16, 20, 24, 28, 34, 42, 50, 54, 76, 158,
      0,
    ])
    let offset = header.main_data_offset()
    let payload = Bytes::makei(frame.length() - offset, fn(i) {
      frame[offset + i]
    })
    let main = reservoir.restore(payload, side.main_data_begin)
    assert_eq(
      main, b"\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x01\xbf\x95\x00\xff\x2a\xfc\xa8\x0f\xf2\xaf\xca\x80\xff\x2a\xfc\xa8\x0f\xf2\xaf\xca\x80\xff\x2a\xfc\xa8\x0f\xf2\xaf\xca\x80\xff\x2a\xfc\xa8\x0f\xf2\xaf\xca\x80\xff\x2a\xfc\xa8\x0f\xf2\xaf\xca\x80\xff\x2a\xfc\xa8\x0f\xf2\xaf\xca\x80\xff\x2a\xfc\xa8\x0f\xf2\xaf\xca\x80\xff\x2a\xfc\xa8\x0f\xf2\xaf\xca\x80\xff\x2a\xfc\xa8\x0f\xf2\xaf\xca\x80\xff\x2a\xfc\xa8\x0f\xf2\xaf\xca\x80\x6f\xe5\x40",
    )
    reservoir.save(main, 1492)
    assert_eq(reservoir.history, b"")
  }
  {
    let frame = b"\xff\xfb\x52\xc0\x00\x00\x0b\xbc\x2a\xc8\x0b\xde\xe4\x81\x77\x85\x59\x01\x7b\xdc\x90\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x00\x3f\x95\x1c\x07\xf9\x57\xe5\x40\x7f\x95\x7e\x54\x07\xf9\x57\xe5\x40\x7f\x95\x7e\x54\x07\xf9\x57\xe5\x40\x7f\x95\x7e\x54\x07\xf9\x57\xe5\x40\x7f\x95\x7e\x54\x07\xf9\x57\xe5\x40\x7f\x95\x7e\x54\x07\xf9\x57\xe5\x40\x7f\x95\x7e\x54\x07\xf9\x57\xe5\x40\x7f\x95\x7e\x54\x07\xf9\x57\xe5\x40\x7f\x95\x7e\x54\x07\xf9\x57\xe5\x40\x7f\x95\x7e\x54\x07\xf9\x57\xe5\x40\x7f\x95\x7e\x54\x00\x7f\x2a\x38"
    let header = @header.parse(frame).unwrap()
    let side = read_side_info(frame, header)
    assert_eq(side.main_data_begin, 0)
    assert_eq(header.main_data_offset() * 8, 168)
    assert_eq(side.granules.length(), 2)
    assert_eq(side_flatten(side.granules[0]), [
      751, 21, 0, 100, 0, 0, 22, 0, 0, 0, 0, 0, 23, 23, 23, 2, 2, 255, 0, 0, 0, 4,
      4, 4, 4, 4, 4, 6, 6, 8, 8, 10, 12, 16, 20, 24, 28, 34, 42, 50, 54, 76, 158,
      0,
    ])
    assert_eq(side_flatten(side.granules[1]), [
      751, 21, 0, 100, 0, 0, 22, 0, 0, 0, 0, 0, 23, 23, 23, 2, 2, 255, 0, 0, 0, 4,
      4, 4, 4, 4, 4, 6, 6, 8, 8, 10, 12, 16, 20, 24, 28, 34, 42, 50, 54, 76, 158,
      0,
    ])
    let offset = header.main_data_offset()
    let payload = Bytes::makei(frame.length() - offset, fn(i) {
      frame[offset + i]
    })
    let main = reservoir.restore(payload, side.main_data_begin)
    assert_eq(
      main, b"\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x03\xfc\xab\xf2\xa0\x3f\xca\xbf\x2a\x00\x3f\x95\x1c\x07\xf9\x57\xe5\x40\x7f\x95\x7e\x54\x07\xf9\x57\xe5\x40\x7f\x95\x7e\x54\x07\xf9\x57\xe5\x40\x7f\x95\x7e\x54\x07\xf9\x57\xe5\x40\x7f\x95\x7e\x54\x07\xf9\x57\xe5\x40\x7f\x95\x7e\x54\x07\xf9\x57\xe5\x40\x7f\x95\x7e\x54\x07\xf9\x57\xe5\x40\x7f\x95\x7e\x54\x07\xf9\x57\xe5\x40\x7f\x95\x7e\x54\x07\xf9\x57\xe5\x40\x7f\x95\x7e\x54\x07\xf9\x57\xe5\x40\x7f\x95\x7e\x54\x00\x7f\x2a\x38",
    )
    reservoir.save(main, 1502)
    assert_eq(reservoir.history, b"")
