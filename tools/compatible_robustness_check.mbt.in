// Keep partial frames and recoveries when malformed input eventually fails.
///|
struct RobustCompatible {
  frames : Array[PcmFrame]
  recoveries : Array[String]
  error : String?
}

///|
fn robustness_compatible_stream(data : Bytes, chunks : Array[Int]) -> RobustCompatible raise {
  let recoveries : Array[String] = []
  let decoder = Decoder::new(mode=Compatible, on_recovery=event => recoveries.push(event.to_string()))
  let frames : Array[PcmFrame] = []
  let mut position = 0
  let mut turn = 0
  let mut sample_count = 0
  let mut finished = false
  while true {
    assert_true(turn <= data.length() * 3 + 100, msg="compatible decoder stopped making progress")
    assert_true(decoder.buffered_bytes() <= Limits::default().max_buffer_bytes)
    turn += 1
    let step = match (try? decoder.next_frame()) {
      Ok(step) => step
      Err(error) => return { frames, recoveries, error: Some(error.to_string()) }
    }
    match step {
      Frame(frame) => {
        assert_true(frame.channels == 1 || frame.channels == 2)
        assert_true(frame.sample_rate > 0)
        assert_true(frame.source_offset >= 0L && frame.source_offset < data.length().to_int64())
        if !frames.is_empty() {
          assert_true(frame.source_offset > frames[frames.length() - 1].source_offset)
        }
        for sample in frame.samples {
          let value = sample.to_double()
          assert_true(!value.is_nan() && !value.is_inf())
        }
        sample_count += frame.samples.length()
        assert_true(sample_count <= Limits::default().max_output_samples)
        frames.push(frame)
      }
      NeedMoreInput => {
        assert_true(!finished, msg="compatible decoder requested data after EOF")
        if position == data.length() {
          decoder.finish_input()
          finished = true
        } else {
          let requested = chunks[turn % chunks.length()]
          let count = if requested < data.length() - position { requested } else { data.length() - position }
          let accepted = decoder.push(data[position:position + count].to_bytes())
          assert_true(accepted > 0 && accepted <= count)
          position += accepted
        }
      }
      EndOfInput => {
        assert_true(finished)
        assert_eq(position, data.length())
        assert_true(decoder.next_frame() is EndOfInput)
        return { frames, recoveries, error: if frames.is_empty() { Some("NoAudio") } else { None } }
      }
    }
  } nobreak {
    fail("compatible decoder did not terminate")
  }
}

///|
fn robustness_frame_equal(actual : Array[PcmFrame], expected : Array[PcmFrame]) -> Unit raise {
  assert_eq(actual.length(), expected.length())
  for i = 0; i < actual.length(); i = i + 1 {
    assert_eq(actual[i].sample_rate, expected[i].sample_rate)
    assert_eq(actual[i].channels, expected[i].channels)
    assert_eq(actual[i].source_offset, expected[i].source_offset)
    assert_eq(actual[i].samples, expected[i].samples)
  }
}

///|
fn robustness_compatible_same(data : Bytes, chunks : Array[Int]) -> Unit raise {
  let whole = robustness_compatible_stream(data, [data.length() + 1])
  let fragmented = robustness_compatible_stream(data, chunks)
  assert_eq(fragmented.error, whole.error)
  assert_eq(fragmented.recoveries, whole.recoveries)
  robustness_frame_equal(fragmented.frames, whole.frames)
  match (try? decode_frames(data, mode=Compatible)) {
    Ok(audio) => {
      assert_eq(whole.error, None)
      robustness_frame_equal(whole.frames, audio.frames)
      assert_eq(whole.recoveries, audio.recoveries.map(event => event.to_string()))
    }
    Err(error) => assert_eq(whole.error, Some(error.to_string()))
  }
}
